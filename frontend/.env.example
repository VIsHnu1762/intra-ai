# Intra AI — Frontend Environment Variables

# Base URL for FastAPI REST endpoints (Required)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Agora RTC App ID for client-side WebRTC voice channel join (Required for live voice interview)
NEXT_PUBLIC_AGORA_APP_ID=

# Application Environment: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Optional WebSocket URL for real-time telemetry/streaming (if using standalone WS)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
