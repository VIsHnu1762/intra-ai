# Project 2: AI Interviewer & Skill Assessment Platform
# Video + Voice

# --- LLM ---
OPENAI_API_KEY=sk-...
# For fine-tuning:
# HF_TOKEN=hf_...

# --- Video / CV ---
# MediaPipe + OpenCV (local, no keys)
# For cloud vision:
# GOOGLE_CLOUD_VISION_KEY=...

# --- Audio ---
DEEPGRAM_API_KEY=...          # Real-time transcription
# Or: WHISPER_MODEL=large-v3

# --- Data Warehouse ---
# BigQuery:
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
BIGQUERY_PROJECT_ID=...
BIGQUERY_DATASET=interviewer
# Or Delta Lake (local, no keys)

# --- Streaming ---
SPARK_MASTER=local[*]
# Or: SPARK_MASTER=spark://host:7077

# --- Database ---
POSTGRES_URL=postgresql://user:pass@localhost:5432/ai_interviewer
REDIS_URL=redis://localhost:6379

# --- WebRTC ---
TURN_SERVER_URL=...
TURN_USERNAME=...
TURN_PASSWORD=...

# --- App ---
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your-secret-key
