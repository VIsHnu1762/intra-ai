# ── App ──────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── Supabase / Postgres ─────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=

# ── AICredits: explicit M1 / Meta-Orchestrator slots ──────
# Current interview intelligence, routing, and post-interview transport.
# Nano/Flash-Lite remain separate report credential slots; keys never substitute for each other.
AICREDITS_API_KEY_GPT5_NANO=
AICREDITS_API_KEY_GEMINI_FLASH_LITE=
# Optional overrides. Blank uses the verified defaults below:
# openai/gpt-5-nano, google/gemini-2.5-flash-lite,
# https://api.aicredits.in/v1, timeout 60 seconds.
AICREDITS_GPT5_NANO_MODEL=
AICREDITS_GEMINI_FLASH_LITE_MODEL=
# Optional realtime model overrides; blank retains each model slot above.
# These do not change the post-interview report models or credential slots.
AICREDITS_M1_MODEL=google/gemini-3.1-flash-lite
AICREDITS_ORCHESTRATOR_MODEL=google/gemini-3.1-flash-lite
AICREDITS_BASE_URL=
AICREDITS_TIMEOUT_SECONDS=
# Realtime M1/Meta timeout is separate; blank defaults to 30 seconds.
AICREDITS_REALTIME_TIMEOUT_SECONDS=
# Nano M1 reasoning only; default minimal. Report generation is unchanged.
AICREDITS_M1_REASONING_EFFORT=

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AWS S3 ───────────────────────────────────────────────
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_CLOUDFRONT_DOMAIN=

# ── Resend ───────────────────────────────────────────────
RESEND_API_KEY=
# Sender address from a verified Resend domain, optionally: Intra AI <hr@example.com>
RESEND_FROM_EMAIL=

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── URLs ─────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Optional ─────────────────────────────────────────────
DEEPGRAM_API_KEY=

# ── Intra AI Intelligence ────────────────────────────────
M1_PROVIDER=aicredits
# Independent AICredits credentials; realtime model overrides are above.
ORCHESTRATOR_PROVIDER=aicredits
# Inactive compatibility providers. They are used only when explicitly selected.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=https://ollama.com/v1
GROQ_API_KEY=
GROQ_M1_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=20.0

# ── Optional Groq Meta-Orchestrator compatibility ─────────
# Used only when ORCHESTRATOR_PROVIDER=groq.
GROQ_ORCHESTRATOR_API_KEY=
GROQ_ORCHESTRATOR_MODEL=openai/gpt-oss-20b
GROQ_ORCHESTRATOR_BASE_URL=https://api.groq.com/openai/v1
GROQ_ORCHESTRATOR_TIMEOUT_SECONDS=20.0

# ── Agora Agent Studio ───────────────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional shared published Custom LLM pipeline base for all interview personas.
# Keeps each persona's own RTC UID, greeting, and TTS voice; overrides legacy pipeline IDs below.
AGORA_CUSTOM_LLM_PIPELINE_ID=
AGORA_ALEX_PROJECT_ID=acbcfc97ea094e3681d46fe8da21e4d1
AGORA_ALEX_PIPELINE_ID=eb714d82ec524f14981e5b5f5108cbd1
AGORA_JORDAN_PROJECT_ID=acbcfc97ea094e3681d46fe8da21e4d1
AGORA_JORDAN_PIPELINE_ID=642bb4345fa244099a78a50cede2d7d3
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_REST_API_KEY=
AGORA_REST_API_SECRET=
CUSTOM_LLM_URL=

# ── Neo4j AuraDB (Knowledge Graph) ───────────────────────
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Separate Agora Studio project: candidate training and recruiter assistant.
# Do not reuse the official Alex/Jordan project's credentials here.
AGORA_TRAINING_HR_APP_ID=
AGORA_TRAINING_HR_APP_CERTIFICATE=
AGORA_TRAINING_HR_API_TOKEN=
AGORA_TAYLOR_AGENT_ID=
AGORA_TAYLOR_AGENT_RTC_UID=
AGORA_MORGAN_AGENT_ID=
AGORA_MORGAN_AGENT_RTC_UID=
# studio inherits its saved LLM; managed uses Agora's model credentials.
# Managed startup clears inherited custom proxy params before accepting audio.
AGORA_MORGAN_LLM_MODE=studio
AGORA_MORGAN_MANAGED_MODEL=gpt-4.1-mini
AGORA_TAYLOR_LLM_MODE=studio
AGORA_TAYLOR_MANAGED_MODEL=gpt-4.1-mini
# Public HTTPS origin of this backend; Agora connects to /api/v1/voice/mcp.
VOICE_ASSISTANT_PUBLIC_URL=
VOICE_ASSISTANT_SESSION_SECONDS=1800
VOICE_ASSISTANT_IDLE_SECONDS=90
# Server-only Composio Tool Router connection for Morgan's controlled bridge.
MORGAN_COMPOSIO_MCP_URL=
MORGAN_COMPOSIO_API_KEY=
# Persisted recruiter user allowed to use this server-owned connection.
MORGAN_COMPOSIO_OWNER_USER_ID=

# Agora NCS webhook HMAC-SHA256 secret. Never use a model or Custom LLM key here.
AGORA_NOTIFICATION_SECRET=

# Isolated feature domains. New reasoning uses the existing AICredits key above.
CANDIDATE_ONBOARDING_ENABLED=true
COMPANY_KNOWLEDGE_ENABLED=true
ROLE_PLAY_ENABLED=true
GROUP_DISCUSSION_ENABLED=true
AICREDITS_RESUME_MODEL=google/gemini-3.1-flash-lite
AICREDITS_ROLE_PLAY_MODEL=google/gemini-3.1-flash-lite
AICREDITS_GD_MODEL=google/gemini-3.1-flash-lite
AICREDITS_COMPANY_MODEL=google/gemini-3.1-flash-lite
# Optional dedicated invitation secret; otherwise the existing JWT_SECRET is used.
# Either must have at least 32 bytes when issuing GD invitations.
GD_INVITATION_SECRET=
